[Unit]
Description=InvestLab daily monitoring (manual execution only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=investlab
Group=investlab
Environment=INVESTLAB_HOME=/var/lib/investlab
EnvironmentFile=-/etc/investlab/private.env
ExecStart=/usr/bin/bash /opt/investlab/deploy/run-daily.sh
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/investlab
PrivateTmp=true
TimeoutStartSec=1800
